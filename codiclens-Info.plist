<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Merged into the Info.plist Xcode generates (INFOPLIST_FILE beside
	GENERATE_INFOPLIST_FILE). Why these types at Alternate rather than
	public.item at None: AGENTS.md, "Incoming Subjects".
	-->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Anything</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.text</string>
				<string>public.log</string>
				<string>public.composite-content</string>
				<string>public.spreadsheet</string>
				<string>public.presentation</string>
				<string>public.image</string>
				<string>public.audiovisual-content</string>
				<string>public.archive</string>
				<string>public.disk-image</string>
				<string>public.executable</string>
				<string>public.font</string>
				<string>public.3d-content</string>
				<string>public.database</string>
				<string>public.calendar-event</string>
				<string>public.contact</string>
				<string>public.message</string>
				<string>public.stored-url</string>
				<string>com.apple.property-list</string>
				<string>com.microsoft.word.doc</string>
				<string>public.x509-certificate</string>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Open in Codiclens</string>
			</dict>
			<key>NSMessage</key>
			<string>openInCodiclens</string>
			<key>NSPortName</key>
			<string>$(PRODUCT_NAME)</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.item</string>
			</array>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
			</array>
		</dict>
	</array>
	<!--
	Sparkle (SparkleUpdater.swift). The feed and the key come from build
	settings so a local test feed can be built without editing this file.
	SPARKLE_PUBLIC_ED_KEY matches the signing key for login Keychain
	account codiclens (#20). Only the public key belongs in the project.
	No SUEnable*Service keys: Codiclens is not sandboxed.
	-->
	<key>SUFeedURL</key>
	<string>$(SPARKLE_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>$(SPARKLE_PUBLIC_ED_KEY)</string>
	<key>SURequireSignedFeed</key>
	<true/>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>SUAutomaticallyUpdate</key>
	<false/>
</dict>
</plist>
