	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Open in Codiclens</string>
			</dict>
			<key>NSMessage</key>
			<string>openInCodiclens</string>
			<key>NSPortName</key>
			<string>$(PRODUCT_NAME)</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.item</string>
			</array>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
